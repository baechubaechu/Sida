[Unit]
Description=Sida: this month's 건축물대장 packs from 건축HUB (does nothing until a new month is out)
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
User=ledger
Group=ledger
ExecStart=/usr/bin/python3 /opt/sida-kr/ledger-sync/ledger_pull.py --out /opt/sida-kr/ledger --work /var/tmp/sida-ledger --region seoul=11
Nice=15
IOSchedulingClass=idle
MemoryMax=400M
TimeoutStartSec=2h
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
# Not PrivateTmp: it gives the service its own empty /var/tmp, so /var/tmp/sida-ledger below would be
# missing and the service would not start (status 226/NAMESPACE).
PrivateTmp=no
ReadWritePaths=/opt/sida-kr/ledger /var/tmp/sida-ledger
# ProtectSystem=strict leaves /tmp and /var/tmp read-only, and SQLite sorts CREATE INDEX in a temp file
# ("disk I/O error" otherwise), so its temp files go to the work folder.
Environment=SQLITE_TMPDIR=/var/tmp/sida-ledger TMPDIR=/var/tmp/sida-ledger
