[Unit]
Description=Sida: this month's 건축물대장 packs from 건축HUB (does nothing until a new month is out)
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
User=ledger
Group=ledger
ExecStart=/usr/bin/python3 /opt/sida-kr/ledger-sync/ledger_pull.py --out /opt/sida-kr/ledger --work /var/tmp/sida-ledger --region seoul=11
Nice=15
IOSchedulingClass=idle
MemoryMax=400M
TimeoutStartSec=2h
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
ReadWritePaths=/opt/sida-kr/ledger /var/tmp/sida-ledger
# ProtectSystem=strict leaves /tmp read-only: SQLite sorts for CREATE INDEX in the work folder instead.
# No PrivateTmp: it would hide /var/tmp/sida-ledger from the service (status 226/NAMESPACE).
Environment=SQLITE_TMPDIR=/var/tmp/sida-ledger TMPDIR=/var/tmp/sida-ledger
