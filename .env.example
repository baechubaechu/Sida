# OpenRouter API key
# Get one at: https://openrouter.ai/keys
# Or enter it on the web settings screen (it is checked, then saved here)
OPENROUTER_API_KEY=

# OpenAI API key (Rhino modeling, a later special feature; GPT-6+)
# https://platform.openai.com/api-keys
# OPENAI_API_KEY=

# Statute search (law search API, regulation_checker) uses LAW_OPEN_API_OC below.

# Site facts — address lookup (parcel, zoning). See docs/dev-setup.md "대지 조회용 키".
# VWorld open API key and the service URL registered with it (e.g. http://localhost:8765)
# VWORLD_API_KEY=
# VWORLD_DOMAIN=http://localhost:8765
# data.go.kr 일반 인증키 (Decoding) — 행위제한, 근거 조문, 건축물대장
# DATA_GO_KR_API_KEY=
# law.go.kr OPEN API OC value — statute search (지능형 법령검색) now, ordinance text later
# LAW_OPEN_API_OC=
# Sida data server (relay/README.md): the three services above go through it when this PC has
# no key of its own for that service and both values below are set. An own key is always used
# directly. The access key (sida_…) is given to each person by the team.
# SIDA_RELAY_URL=https://sida-kr.duckdns.org
# SIDA_RELAY_TOKEN=
