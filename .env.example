# OpenRouter API key
# Get one at: https://openrouter.ai/keys
# Or run: python setup_env.py
OPENROUTER_API_KEY=

# OpenAI API key (hub → m Rhino modeling; GPT-6+)
# https://platform.openai.com/api-keys
# OPENAI_API_KEY=

# Optional: VPS RAG API (rag.provider: http). See docs/rag_api.md
# SIDA_RAG_URL=https://your-vps.example.com
# SIDA_RAG_API_KEY=

# Site facts — `/site <주소>` (parcel, zoning). See docs/dev-setup.md "대지 조회용 키".
# VWorld open API key and the service URL registered with it (e.g. http://localhost:8765)
# VWORLD_API_KEY=
# VWORLD_DOMAIN=http://localhost:8765
# data.go.kr 일반 인증키 (Decoding) — 행위제한·건축물대장, used from the next stage on
# DATA_GO_KR_API_KEY=
# law.go.kr OPEN API OC value — ordinance text, used from a later stage on
# LAW_OPEN_API_OC=
